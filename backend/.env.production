# ===========================================
# PPAfan - Attendance System - PRODUCTION Environment
# ===========================================
# Note: Sensitive values are configured directly on the server
# This file is used as a template during deployment

# Database - Set MONGO_URI on server with actual MongoDB Atlas connection string
MONGO_URI=

# Authentication Secrets - Set on server with unique random values
JWT_SECRET=
SESSION_SECRET=
CSRF_SECRET=
ENCRYPTION_KEY=

# Server Configuration
HTTP_PORT=8081
HTTPS_PORT=5001
NODE_ENV=production
LOG_LEVEL=info
TZ=Africa/Lagos

# System Information
SYSTEM_NAME=PPAfan
SYSTEM_VERSION=1.0.0
DEFAULT_CURRENCY=NGN
DEFAULT_VAT_RATE=7.5

# Feature Flags
ENABLE_ATTENDANCE=true
ENABLE_DEVICES=true
ENABLE_NOTIFICATIONS=true
ENABLE_REPORTS=true

# Email Configuration (Values set on server)
MAIL_HOST=premium304.web-hosting.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=app@ppafan.org
MAIL_PASSWORD=
MAIL_FROM_NAME=PPAfan Attendance
MAIL_FROM_EMAIL=app@ppafan.org

# Notification Recipients
NOTIFICATION_EMAILS=admin@ppafan.org

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
CORS_ORIGIN=https://app.ppafan.org

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# reCAPTCHA - Set secret key on server
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Production Domain
PRODUCTION_DOMAIN=app.ppafan.org
